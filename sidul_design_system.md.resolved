## 6. Skema Database

```mermaid
erDiagram
    USERS {
        int id_user PK
        string name
        string username
        string password
        enum role
    }
    MAHASISWAS {
        int id_mahasiswa PK
        int user_id FK
        string nim UK
        string nama
        int dosen_wali_id FK
        enum status_magang
    }
    DOSENS {
        int id_dosen PK
        int user_id FK
        string nik UK
        string nama
    }
    MAGANGS {
        int id_magang PK
        string kode_magang UK
        string nim
        string perusahaan
        string konsentrasi
        string tipe_magang
        int dosen_pembimbing_id FK
        string status_magang
    }
    PESERTA_MAGANGS {
        int id_peserta_magang PK
        int id_mahasiswa FK
        int id_magang FK
        string nim
    }
    LOGBOOKS {
        int id_logbook PK
        int id_magang FK
        text logbook
        text catatan_dosen
    }
    LAPORANS {
        int id_laporan PK
        int id_magang FK
        text laporan
        enum status_laporan
    }

    USERS ||--o| MAHASISWAS : "punya"
    USERS ||--o| DOSENS : "punya"
    DOSENS ||--o{ MAHASISWAS : "wali dari"
    DOSENS ||--o{ MAGANGS : "membimbing"
    MAGANGS ||--o{ PESERTA_MAGANGS : "diikuti oleh"
    MAHASISWAS ||--o{ PESERTA_MAGANGS : "ikut serta dalam"
    MAGANGS ||--o{ LOGBOOKS : "memiliki"
    MAGANGS ||--o| LAPORANS : "memiliki"
```

